{
  "name": "villagerslauncher",
  "productName": "VillagersLauncher",
  "version": "1.1.3",
  "description": "Лаунчер сборки MineVillagers от Кокка",
  "author": "Kokk",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "check": "node scripts/check.cjs",
    "dist": "vite build && electron-builder --win nsis --publish never",
    "release": "vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.1.0",
    "vite": "^5.4.11",
    "@fontsource/press-start-2p": "^5.1.0",
    "@fontsource/manrope": "^5.1.0"
  },
  "build": {
    "appId": "ru.kokk.villagerslauncher",
    "productName": "VillagersLauncher",
    "artifactName": "VillagersLauncher-Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VillagersLauncher",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kokkas56",
        "repo": "VillagersLauncher",
        "releaseType": "release"
      }
    ]
  }
}